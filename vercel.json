{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/inicio", "destination": "/index.html" },
    { "source": "/inicio/", "destination": "/index.html" },
    { "source": "/agendar", "destination": "/index.html" },
    { "source": "/agendar/", "destination": "/index.html" },
    { "source": "/barbeiro/:path*", "destination": "/index.html" },
    { "source": "/whatsapp/:path*", "destination": "/index.html" },
    { "source": "/auth/login", "destination": "/index.html" },
    { "source": "/auth/callback", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
